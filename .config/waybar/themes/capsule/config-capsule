{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "margin-bottom": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "clock",
        "custom/pacman"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/phone",
        "network",
        "pulseaudio",
        "battery",
        "custom/notification",
        "tray"
    ],
    "clock": {
        "format": "󰊠  {:%a, %b %d  •  %H:%M}",
        "format-alt": "󰃭  {:%A, %d %B %Y  •  %T}",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "custom/pacman": {
        "format": "󰅢 {}",
        "interval": 3600,
        "exec": "~/.config/waybar/scripts/check-updates.sh",
        "on-click": "alacritty --class update-terminal -e ~/.config/waybar/scripts/system-update.sh",
        "signal": 8,
        "tooltip": true,
        "tooltip-format": "Updates Available"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰮯",
            "occupied": "•",
            "default": "•",
            "empty": "•"
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },
    "custom/phone": {
        "format": "{}",
        "return-type": "json",
        "exec": "phone-monitor --bar",
        "interval": 8,
        "on-click": "alacritty -T 'Phone Monitor' -e phone-monitor",
        "on-click-right": "phone-monitor --mirror",
        "tooltip": true
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤮",
        "tooltip": true,
        "tooltip-format-wifi": "SSID: {essid} ({signalStrength}%)",
        "on-click": "alacritty -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 4,
        "tooltip": true
    },
    "battery": {
        "interval": 2,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "on-click": "~/.config/hypr/scripts/power-mode.sh menu"
    },
    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Notifications & Control Center",
        "format": "󰂚",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}
