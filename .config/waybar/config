{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "margin-bottom": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "clock",
        "custom/pacman",
        "tray"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/phone",
        "group/expand",
        "network",
        "pulseaudio",
        "battery",
        "custom/notification"
    ],
    "clock": {
        "format": "󰊠  {:%a, %b %d  •  %H:%M}",
        "format-alt": "󰃭  {:%A, %d %B %Y  •  %T}",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "custom/pacman": {
        "format": "󰅢 {}",
        "interval": 3600,
        "exec": "~/.config/waybar/scripts/check-updates.sh",
        "on-click": "alacritty --class update-terminal -e ~/.config/waybar/scripts/system-update.sh",
        "signal": 8,
        "tooltip": true,
        "tooltip-format": "Arch Updates Available\nClick to update system"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰮯",
            "occupied": "•",
            "default": "•",
            "empty": "•"
        },
        "sort-by-number": true,
        "on-click": "activate",
        "tooltip": true,
        "tooltip-format": "Workspace {name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },
    "custom/phone": {
        "format": "{}",
        "return-type": "json",
        "exec": "phone-monitor --bar",
        "interval": 8,
        "on-click": "alacritty -T 'Phone Monitor' -e phone-monitor",
        "on-click-right": "phone-monitor --mirror",
        "tooltip": true
    },
    "custom/expand": {
        "format": "󰄼",
        "tooltip": false
    },
    "custom/endpoint": {
        "format": " ",
        "tooltip": false
    },
    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": [
            "custom/expand",
            "cpu",
            "memory",
            "temperature",
            "custom/endpoint"
        ]
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": true,
        "on-click": "alacritty -e btop"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 3,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB",
        "on-click": "alacritty -e btop"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "tooltip": true
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  Offline",
        "format-disabled": "󰤮  Disabled",
        "rfkill": false,
        "tooltip-format-disconnected": "Network Disconnected",
        "tooltip-format-wifi": "SSID: {essid}\nStrength: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
        "on-click": "alacritty -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰄡",
            "portable": "󰄡",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "alacritty -e pulsemixer",
        "scroll-step": 4,
        "tooltip": true,
        "tooltip-format": "{desc} • {volume}%"
    },
    "battery": {
        "interval": 2,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{capacity}% ({time})\nClick: Power Mode Menu",
        "on-click": "~/.config/hypr/scripts/power-mode.sh menu"
    },
    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Notifications & Quick Settings\nClick to open shade",
        "format": "󰂚",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    }
}
