@import "~/.cache/wal/colors-rofi-dark"

/* =============================================================================
 * Android 17 / Material 3 Expressive - Quick Settings Menu
 * ============================================================================= */

configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: false;
    location: 0;
    yoffset: 0;
    xoffset: 0;
    fixed-num-lines: true;
    hide-scrollbar: true;
    click-to-exit: true;
    cycle: true;
}

* {
    background-color: transparent;
}

window {
    width: 660px;
    border-radius: 28px;
    border: 2px;
    border-color: alpha(@selected-normal-background, 0.45);
    background-color: alpha(@background-color, 0.90);
    padding: 0px;
}

mainbox {
    border-radius: 28px;
    padding: 22px;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 10px 20px;
    spacing: 12px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    children: [ prompt, entry ];
}

prompt {
    text-color: @selected-normal-background;
    font: "JetBrainsMono Nerd Font Bold 15";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search quick settings & options...";
    placeholder-color: rgba(255, 255, 255, 0.40);
    text-color: @text-color;
    font: "JetBrainsMono Nerd Font 11";
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 8px;
    padding: 4px 0px 0px 0px;
    scrollbar: false;
}

element {
    padding: 12px 18px;
    border-radius: 18px;
    spacing: 14px;
    background-color: rgba(255, 255, 255, 0.04);
    text-color: @text-color;
    cursor: pointer;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

element normal.normal {
    background-color: rgba(255, 255, 255, 0.04);
    text-color: @text-color;
}

element normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
    border-radius: 18px;
}

element normal.active {
    background-color: rgba(255, 255, 255, 0.08);
    text-color: @selected-normal-background;
    border-radius: 18px;
}

element selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
    border-radius: 18px;
    border-color: @selected-normal-background;
}

element selected.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
    border-radius: 18px;
}

element selected.active {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
    border-radius: 18px;
}

element alternate.normal {
    background-color: rgba(255, 255, 255, 0.04);
    text-color: @text-color;
}

element-text {
    vertical-align: 0.5;
    cursor: inherit;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 10.5";
}
