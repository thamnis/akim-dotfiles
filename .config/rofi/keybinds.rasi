@import "~/.cache/wal/colors-rofi-dark"

/* =============================================================================
 * Android 17 / Material 3 Expressive - Keybinds Cheatsheet
 * ============================================================================= */

configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: false;
    location: 0;
    yoffset: 0;
    xoffset: 0;
    fixed-num-lines: true;
    hide-scrollbar: false;
    click-to-exit: true;
    cycle: true;
}

* {
    background-color: transparent;
}

window {
    width: 840px;
    height: 580px;
    border-radius: 28px;
    border: 2px;
    border-color: alpha(@selected-normal-background, 0.45);
    background-color: alpha(@background-color, 0.90);
    padding: 0px;
}

mainbox {
    border-radius: 28px;
    padding: 22px;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 10px 20px;
    spacing: 12px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    children: [ prompt, entry ];
}

prompt {
    text-color: @selected-normal-background;
    font: "JetBrainsMono Nerd Font Bold 14";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search shortcuts by key or action...";
    placeholder-color: rgba(255, 255, 255, 0.40);
    text-color: @text-color;
    font: "JetBrainsMono Nerd Font 11";
    vertical-align: 0.5;
}

listview {
    lines: 11;
    columns: 1;
    spacing: 6px;
    scrollbar: true;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-width: 6px;
    handle-color: @selected-normal-background;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

element {
    border-radius: 14px;
    padding: 10px 14px;
    spacing: 12px;
}

element normal.normal {
    background-color: transparent;
    text-color: @text-color;
}

element alternate.normal {
    background-color: rgba(255, 255, 255, 0.02);
    text-color: @text-color;
}

element selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
    border-radius: 14px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 10.5";
}
